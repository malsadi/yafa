#!/usr/bin/env bash
# D-057: the public progress page is current in every commit. The "Now:"
# and "Now (ar):" lines in docs/current-work.md must change with each commit; this hook then
# stamps "Updated:" with the commit's own time (UK) and regenerates the page,
# adding both to the commit.
set -euo pipefail

file=docs/current-work.md

for label in 'Now' 'Now \(ar\)'; do
  if ! git diff --cached -U0 -- "$file" | grep -qE "^\+${label}: .+"; then
    echo "pre-commit: say what this commit is about in the \"${label//\\/}:\" line of $file, in English and Arabic (D-057, D-058)." >&2
    exit 1
  fi
done

node -e '
const fs = require("node:fs");
const file = process.argv[1];
const parts = Object.fromEntries(
  new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/London", year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  }).formatToParts(new Date()).map((part) => [part.type, part.value]),
);
const stamp = `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}`;
fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace(/^Updated: .*$/m, `Updated: ${stamp}`));
' "$file"

npm run --silent progress-page
git add "$file" public/progress.html public/progress.ar.html
