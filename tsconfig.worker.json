{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker/**/*.ts",
    "src/db/**/*.ts",
    "src/shared/**/*.ts",
    "tests/core/**/*.ts",
    "tests/middleware/**/*.ts",
    "tests/api/**/*.ts",
    "tests/permissions/**/*.ts",
    "tests/integrity/**/*.ts",
    "tests/shared/**/*.ts",
    "tests/setup/**/*.ts",
    "tests/cron/**/*.ts",
    "tests/queues/**/*.ts",
    "tests/api-me/**/*.ts",
    "tests/webhooks/**/*.ts",
    "tests/app/**/*.ts",
    "tests/privacy-notice/**/*.ts",
    "tests/pdf-remote/render-samples.worker.ts",
    "tests/pdf-remote/pdf-samples.ts",
    "tests/pdf-remote/font-modules.d.ts"
  ]
}
